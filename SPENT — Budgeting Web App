                            <span>No budget set</span>
                        </div>

                        <div class="progress-track">
                            <div class="progress-fill" style="width: 0%"></div>
                        </div>
                    </div>

                    <div class="budget-progress-item">
                        <div class="progress-label">
                            <span>Entertainment</span>
                            <span>No budget set</span>
