<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nike Landing Page</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">

<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="styles.css">
</head>
<body>

    <button id="theme-toggle">🌙</button>
    
    <header>
        <nav class="navbar">

            <div class="logo">
                <h2>NIKE</h2>
            </div>

            <ul class="nav-links">

                <li><a href="#home">Home</a></li>
                <li><a href="#featured">Featured</a></li>
                <li><a href="#categories">categories</a></li>
                <li><a href="#contact">contact</a></li>

            </ul>

            <div class="icons">
                
                <button>
                    🔍
                </button>

                <button  id="cart-button">
                    🛒
                    <span id="cart-count">0</span>
                </button>

            </div>

        </nav>
    </header>

    <main>

        <section id="home" class="hero">

            <div class="hero-text">

                <label>NEW ARRIVALS</label>
                <h1>RUN <span>BEYOND</span> LIMITS</h1>
                <p>Discover the latest collection designed for speed, comfort, and everyday performance.</p>

                <div class="hero-buttons">

                    <button class="shop-btn">Shop Now</button>
                    <button class="learn-btn">Learn More</button>

                </div>
            </div>

            <div class="hero-image">

                <img src="images/shoe.png" alt="Running shoe">

            </div>
        </section>

        <section id="featured" class="featured">
            <h2>Featured Products</h2>

            <div class="product-grid">

                <article class="product-card">

                    <span class="badge">New</span>
                    <img src="images/shoe1.png" alt="Nike Air Zoom">
                    <h3>Nike Air Zoom</h3>
                    <p>Running Shoe</p>
                    <span class="price">$160</span>
                    <button>Add to Cart</button>

                </article>

                <article class="product-card">

                    <img src="images/shoe2.png" alt="Nike Pegasus">
                    <h3>Nike Pegasus</h3>
                    <p>Daily Trainer</p>
                    <span class="price">$140</span>
                    <button>Add to Cart</button>

                </article>

                <article class="product-card">

                    <img src="images/shoe3.png" alt="Nike Revolution">
                    <h3>Nike Revolution</h3>
                    <p>Everyday Comfort</p>
                    <span class="price">$95</span>
                    <button>Add to Cart</button>
                    
                </article>

                <article class="product-card">

                    <img src="images/shoe4.png" alt="Nike Invincible">
                    <h3>Nike Invincible</h3>
                    <p>Maximum Cushion</p>
                    <span class="price">$180</span>
                    <button>Add to Cart</button>

                </article>
                
            </div>
        </section>

        <section id="categories" class="categories">

            <h2>Shop By Category</h2>

            <div class="category-grid">

                <div class="category-card">
                    <img src="images/running.jpg" alt="Running shoes">
                    <h3>Running</h3>
                    <button>Shop Running</button>
                    <article class="product-card" data-category="running"></article>
                </div>

                <div class="category-card">
                    <img src="images/basketball.jpg" alt="Basketball shoes">
                    <h3>Basketball</h3>
                    <button>Shop Basketball</button>
                </div>

                <div class="category-card">
                    <img src="images/lifestyle.jpg" alt="Lifestyle shoes">
                    <h3>Lifestyle</h3>
                    <button>Shop Lifestyle</button>
                </div>

                <div class="category-card">
                    <img src="images/training.jpg" alt="Training shoes">
                    <h3>Training</h3>
                    <button>Shop Training</button>
                </div>

            </div>
        </section>
    </main>

    <footer id="contact">
        
        <div class="footer-content">

            <h2>NIKE</h2>
            <p>Designed as a front-end portfolio project.</p>

            <div class="socials">
                <a href="#">Instagram</a>
                <a href="#">TikTok</a>
                <a href="#">LinkedIn</a>
            </div>

        </div>
        
    </footer>

    <aside class="cart-sidebar">

        <div class="cart-header">

            <h2>Your Cart</h2>
            <button id="close-cart">✖</button>

        </div>

        <div id="cart-items">
            <p>Your cart is empty.</p>
        </div>

    </aside>
   
    <script src="script.js"></script>

</body>
</html>
console.log("JavaScript Connected");

const cartButton = document.querySelector("#cart-button");
const cartSidebar = document.querySelector(".cart-sidebar");
const closeButton = document.querySelector("#close-cart");

cartButton.addEventListener("click", function(){
    cartSidebar.classList.add("open");
});

closeButton.addEventListener("click", function(){
    cartSidebar.classList.remove("open");
});

let cartCount = 0;

const countDisplay = document.querySelector("#cart-count");
const addButtons = document.querySelectorAll(".product-card button");

addButtons.forEach(function(button){
    button.addEventListener("click", function(){
        cartCount++;
        countDisplay.textContent = cartCount;
    });
});

const themeButton = document.querySelector("#theme-toggle");

themeButton.addEventListener("click", function(){
    document.body.classList.toggle("dark");
})

function updateCart(){
    cartItems.innerHTML = "";

    let total = 0;

    cartButton.forEach(function(item){
        const product = document.createElement("p");

        product.textContent =  `${item.name} - ${item.price}`;
        cartItems.appendChild(product);
        total += Number(item.price.replace("$",""));
    });

    const totalElement = document.creaateElement("h3");
    
    totalElement.textContent = 'Total: $${total}';
    cartItems.appendChild(totalElement);
}
/*CSS reset*/
*{
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

/*variables*/
:root{
    --primary: #111111;
    --secondary: #ffffff;
    --accent: #e63946;
    --gray: #666666;
    --light-gray: #eeeeee;
    --radius: 20px;
}

/*Global style*/
body{
    font-family: "Poppins", sans-serif;
    background: var(--secondary);
}

/*Navigation*/
.navbar{
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1300px;
    margin: auto;
    padding: 20px;
    background: var(--secondary);
    border-bottom: 1px solid var(--light-gray);
}

.nav-links{
    list-style: none;
    display: flex;
    gap: 35px;
}

.nav-links a{
    text-decoration: none;
    color: black;
    font-weight: bold;
    transition: .3s;
}

.nav-links a:hover{
    color: var(--gray);
}

.logo h2{
    font-size: 30px;
    letter-spacing: 2px;
}

.icons button{
    border: none;
    background: none;
    font-size: 22px;
    cursor: pointer;
    margin-left: 15px;
    transition: .3s;
}

.icons button:hover{
    transform: scale(1.15);
}

.navbar{
    position: sticky;
    top: 0;
    z-index: 1000;
}

.logo h2:hover{
    color: var(--accent);
}

/*Hero*/
.hero{
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 80px 60px;
    animation: fadeUp .8s ease;
    min-height: 90vh;
}

.hero-text{
    width: 50%;
}

.hero span{
    color: #e63946;
}

.hero-image{
    width: 50%;
    text-align: center;
}

.hero-text h1{
    font-size: 72px;
    line-height: 1.1;
    margin-bottom: 20px;
}

.hero-text p{
    font-size: 18px;
    color: var(--gray);
    margin-bottom: 35px;
    line-height: 1.6;

}

.hero-buttons{
    display: flex;
    gap: 20px;
}

.shop-btn{
    background: var(--primary);
    color: var(--secondary);
    border: none;
    padding: 15px 30px;
    font-size: 16px;
    cursor: pointer;
    border-radius: 30px;
    transition: .3s;
}

.shop-btn:hover{
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, .2);
}

.learn-btn{
    background: var(--secondary);
    color: var(--primary);
    border: 2px solid var(--primary);
    padding: 15px 30px;
    font-size: 16px;
    border-radius: 30px;
    cursor: pointer;
    transition: .3s;
}

.learn-btn:hover{
    background: var(--primary);
    color: var(--secondary);
}

.hero-image img{
    width: 100%;
    max-width: 550px;
}

.hero-image img{
    transition: .4s;
}

.hero-image img:hover{
    transform:scale(1.08);
}

/*Featured Products*/
.featured{
    padding: 80px 60px;
    background: #f7f7f7;;
}

.featured h2{
    text-align: center;
    font-size: 40px;
    margin-bottom: 50px;
}

.product-grid{
    display: grid;
    grid-template-columns:repeat(4,1fr);
    gap: 30px;
}

.badge{
    position: absolute;
    top: 15px;
    left: 15px;
    background-color: var(--accent);
    color: var(--secondary);
    padding: 6px 12px;
    font-size: 14px;
    font-weight: bold;
}

.product-card{
    background: var(--secondary);
    border-radius: 15px;
    padding: 25px;
    text-align: center;
    box-shadow: 0 5px 15px rgba(0,0,0,.1);
    transition: .3s;
    position: relative;
}

.product-card:hover{
    transform:translateY(-10px);
}

.product-card img{
    width: 100%;
    max-width: 260px;
    margin-bottom: 20px;
    transition: .4s;
}

.product-card:hover img{
    transform: scale(1.08) rotate(-2deg);
}

.product-card h3{
    margin-bottom: 10px;
    font-size: 22px;
}

.product-card p{
    color: var(--gray);
    margin-bottom: 15px;
}

.price{
    display: block;
    font-size: 22px;
    font-weight: bold;
    margin-bottom: 20px;
}

.product-card button{
    background: var(--primary);
    color: var(--secondary);
    border: none;
    padding: 12px 25px;
    border-radius: 25px;
    cursor: pointer;
    transition: .3s;
}

.product-card button:hover{
    background: var(--accent);
}


/*Categories*/
.categories{
    padding: 80px 60px;
    background: white;
}

.categories h2{
    text-align: center;
    font-size: 40px;
    margin-bottom: 50px;
}

.category-grid{
    display: grid;
    grid-template-columns: repeat(2,1fr);
    gap: 30px;
}

.category-card{
    position: relative;
    height: 300px;
    overflow: hidden;
    border-radius: 20px;
    cursor: pointer;
}

.category-card img{
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: .4s;
}

.category-card h3{
    position: absolute;
    bottom: 30px;
    left: 30px;
    color: var(--secondary);
    font-size: 34px;
    z-index: 2;
}

.category-card::after{
    content:"";
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.35);
}

.category-card:hover img{
    transform: scale(1.08);
}

.category-card{
    box-shadow: 0 8px 20px var(--primary);
}


.category-card button{
    position: absolute;
    bottom: 30px;
    right: 30px;
}

.category-card button{
    position: absolute;
    bottom: 25px;
    right: 25px;
    z-index: 2;
    background: white;
    color: black;
    border: none;
    padding: 10px 18px;
    border-radius: 25px;
    cursor: pointer;
    transition: .3s;
}

.category-card button:hover{
    background: #e63946;
    color: white;
}
/*Card Sidebar*/
.cart-sidebar{
    position: fixed;
    top: 0;
    right: -400px;
    width: 350px;
    height: 100vh;
    background: var(--secondary);
    box-shadow: -5px 0 15px rgba(0, 0, 0, .2);
    transition: .4s;
    padding: 25px;
    z-index: 2000;

}

.cart-sidebar.open{
    right: 0;
}

.cart-header{
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 25px;
}

#close-cart{
    border: none;
    background: none;
    font-size: 22px;
    cursor: pointer;
}

#cart-button{
    position: relative;
}

#cart-count{
    position: absolute;
    top: -8px;
    right: -8px;
    width: 20px;
    height: 20px;
    background: #e63946;
    color: white;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 12px;
}

html{
    scroll-behavior: smooth;
}

/*Footer*/
footer{
    background: var(--primary);
    color: var(--secondary);
    padding: 60px;
    text-align: center;
}

.socials{
    margin-top: 25px;
}

.socials a{
    color: var(--secondary);
    margin: 0 15px;
    text-decoration: none;
}

body.dark{
    background: #111;
    color: white;
}

body.dark .navbar{
    background: #111;
}

body.dark .product-card{
    background: #111;
}

.body.dark .featured{
    color: white;
}

body.dark .cart-sidebar{
    background: #222;
    color: white;
}

/*Animation*/
@keyframes fadeUp {
    from{
        opacity: 0;
        transform: translateY(30px);
    }
    to{
        opacity: 1;
        transform: translateY(0);
    }
}

/*Media Query*/
@media (max-width:900px){
    .product-grid{
        grid-template-columns: repeat(2,1fr);
    }
}

@media (max-width:600px){
    .product-grid{
        grid-template-columns: 1fr;
    }
}

@media(max-width:900px){
    .category-grid{
        grid-template-columns: 1fr;
    }
}
